{
  "name": "codex-gui",
  "version": "1.2.1",
  "description": "Codex 桌面图形界面客户端",
  "author": "leeha",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build && electron-builder",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test electron/*.test.cjs"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "36.9.5",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.leeha.codexgui",
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "package.json"
    ],
    "win": {
      "icon": "electron/assets/app-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "electron/assets/app-icon.ico",
      "uninstallerIcon": "electron/assets/app-icon.ico",
      "installerHeaderIcon": "electron/assets/app-icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
